<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="moe.crx.overport.vrapismoke">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <uses-feature android:name="android.software.xr.api.openxr" android:required="false" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="com.qualcomm.qti.openxrruntime_broker" />
        <package android:name="com.qualcomm.qti.spaces.services" />
    </queries>
    <application android:label="OVRPort VrApi VRX Smoke" android:hasCode="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
